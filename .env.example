# Skopiuj do .env i wpisz swój klucz (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Opcjonalnie inny model:
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Insiderzy USA (SEC wymaga identyfikacji w nagłówku User-Agent) ---
SEC_USER_AGENT=

# --- Alerty: Telegram (bot z @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alerty: e-mail (Gmail: włącz 2FA i wygeneruj "hasło aplikacji") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
